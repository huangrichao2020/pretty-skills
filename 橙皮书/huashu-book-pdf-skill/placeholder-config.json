{
  "_说明": "新建项目时，把这个文件复制到项目根目录，填入自己的真实信息。然后用 scripts/render-placeholders.py 批量替换 fragments/ 和 PROJECT.md 中的占位符。",

  "作者": {
    "笔名": "{作者名}",
    "真实姓名": "（可选，仅自己知道）",
    "_占位符": ["{作者名}"],
    "_示例": "花叔"
  },

  "出版": {
    "知识星球": "{知识星球名}",
    "_占位符": ["{知识星球名}"],
    "_示例": "AI编程：从入门到精通"
  },

  "公众号": {
    "名称": "{公众号名}",
    "二维码图片": "fragments/gzh-qrcode.jpg",
    "二维码描述": "{公众号二维码描述}",
    "_占位符": ["{公众号名}", "{公众号二维码描述}"],
    "_示例": "公众号：花叔 / alt=\"微信搜一搜「花叔」公众号\""
  },

  "社交媒体": {
    "B站": {
      "用户名": "{B站用户名}",
      "UID": "{B站UID}",
      "URL": "https://space.bilibili.com/{B站UID}/",
      "_占位符": ["{B站用户名}", "{B站UID}"]
    },
    "X": {
      "用户名": "{X用户名}",
      "URL": "https://x.com/{X用户名}",
      "_占位符": ["{X用户名}"]
    },
    "YouTube": {
      "频道": "{YouTube频道}",
      "URL": "https://www.youtube.com/{YouTube频道}",
      "_占位符": ["{YouTube频道}"]
    },
    "GitHub": {
      "用户名": "{GitHub用户名}",
      "URL": "https://github.com/{GitHub用户名}",
      "粉丝数描述": "{GitHub粉丝数}",
      "_占位符": ["{GitHub用户名}", "{GitHub粉丝数}"]
    },
    "小红书": {
      "用户ID": "{小红书用户ID}",
      "_占位符": ["{小红书用户ID}"]
    },
    "官网": {
      "URL": "{官网}",
      "_占位符": ["{官网}"]
    }
  },

  "代表作": {
    "名称": "{代表作名}",
    "成就描述": "{代表作成就}",
    "_占位符": ["{代表作名}", "{代表作成就}"],
    "_示例": "小猫补光灯 / AppStore 付费榜 Top 1"
  },

  "开源项目": {
    "列表": "{开源项目列表}",
    "_占位符": ["{开源项目列表}"],
    "_示例": "女娲.skill、huashu-design"
  },

  "书系列": {
    "已出版数量": "{书数量}",
    "系列其他书名": "{系列其他书名}",
    "_占位符": ["{书数量}", "{系列其他书名}"],
    "_示例": "9 / Claude Code 从入门到精通"
  }
}
